# Cloudflare Turnstile Secret Key
CF_SECRET=1x0000000000000000000000000000000AA

# Allowed CORS Origins (space or comma separated list)
ORIGINS=http://localhost:3000,https://accbusinessclub.asayman.xyz,https://accbusinessclub.cloud

# Server Port
PORT=3000

# Supabase Configuration
SUPABASE_BASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_SECRET=your-supabase-service-role-secret
SUPABASE_REGISTRATION_TABLE_NAME=registrations
SUPABASE_MEMBERS_TABLE_NAME=members

# Auto-ping targets (comma-separated URLs, GET only, https:// assumed when scheme missing)
# Each target runs its own independent loop: 1 request, random 1-10s wait, repeat.
AUTO_PING_TARGETS=

# IDrivee2 S3-compatible object storage — member images (read + write)
S3_ENDPOINT=https://s3.ap-northeast-1.idrivee2.com
S3_REGION=ap-northeast-1
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# Admin bearer token for member write endpoints (POST/PUT/DELETE /api/members/...)
ADMIN_TOKEN=
